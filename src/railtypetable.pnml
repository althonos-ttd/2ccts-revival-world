railtypetable {
    RAIL,
	ELRL,
	MONO,
	MGLV,
	MTRO: [SAB3, "3RDR", MTRO, MONO], // fall back to monorail if no Metro-tracks are available
	NARR: [NAAN, RAIL],
	ELNR: [NAAE, ELRL],
}

#define RAILTYPE_STD  		  RAIL
#define RAILTYPE_NAR_2FT      NARR
#define RAILTYPE_NAR_3FT      NARR
#define RAILTYPE_NAR_750MM    NARR
#define RAILTYPE_NAR_BOSNIAN  NARR
#define RAILTYPE_NAR_CAPE     NARR
#define RAILTYPE_NAR_METRE    NARR
#define RAILTYPE_NAR_ITMETRE  NARR
#define RAILTYPE_BRD_BRUNEL   RAIL
#define RAILTYPE_BRD_DUTCH    RAIL
#define RAILTYPE_BRD_IBERIAN  RAIL
#define RAILTYPE_BRD_INDIAN   RAIL
#define RAILTYPE_BRD_IRISH	  RAIL
#define RAILTYPE_BRD_RUSSIAN  RAIL

#define RAILTYPE_ELEC_STD  		   ELRL
#define RAILTYPE_ELEC_NAR_2FT      ELNR
#define RAILTYPE_ELEC_NAR_3FT      ELNR
#define RAILTYPE_ELEC_NAR_750MM    ELNR
#define RAILTYPE_ELEC_NAR_BOSNIAN  ELNR
#define RAILTYPE_ELEC_NAR_CAPE     ELNR
#define RAILTYPE_ELEC_NAR_METRE    ELNR
#define RAILTYPE_ELEC_NAR_ITMETRE  ELNR
#define RAILTYPE_ELEC_BRD_BRUNEL   ELRL
#define RAILTYPE_ELEC_BRD_DUTCH    ELRL
#define RAILTYPE_ELEC_BRD_IBERIAN  ELRL
#define RAILTYPE_ELEC_BRD_INDIAN   ELRL
#define RAILTYPE_ELEC_BRD_IRISH	   ELRL
#define RAILTYPE_ELEC_BRD_RUSSIAN  ELRL