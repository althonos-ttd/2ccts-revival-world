#define _PASTE2(X, Y) X ## Y
#define TRAIN(ID, NAME, COUNTRY, POWER, GAUGE, ...) \
    item(FEAT_TRAINS, _PASTE2(item_, NAME), ID) { \
        property { \
            name: string(_PASTE2(str_, NAME)); \
            badges: [_PASTE2(BADGE_FLAG_, COUNTRY), _PASTE2(BADGE_REGION_, COUNTRY), _PASTE2(BADGE_POWER_, POWER), _PASTE2(BADGE_GAUGE_, GAUGE), __VA_ARGS__]; \
            track_type: [_PASTE2(RAILTYPE_, GAUGE)]; \
        }\
    }

