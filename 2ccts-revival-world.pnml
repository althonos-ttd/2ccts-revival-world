#define METRO(ID, NAME, COUNTRY, ...) \
    item(FEAT_TRAINS, _PASTE2(item_, NAME), ID) { \
        property { \
            name: string(_PASTE2(str_, NAME)); \
            badges: [_PASTE2(BADGE_FLAG_, COUNTRY), _PASTE2(BADGE_REGION_, COUNTRY), BADGE_POWER_METRO, __VA_ARGS__]; \
            track_type: [MTRO]; \
        }\
    }

//Single Unit Metro
METRO(14000, singlemtro_USA_Brooklyn_Union_Gate_Car, US)
